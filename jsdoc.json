{
  "tags": {
    "allowUnknownTags": false
  },
  "source": {
    "include": "./v2",
    "includePattern": "\\.js$",
    "excludePattern": "(node_modules/|docs)"
  },
  "plugins": [],
  "opts": {
    "template": "template/docdash/",
    "encoding": "utf8",
    "destination": "docs/",
    "recurse": true,
    "verbose": true
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "docdash": {
    "search": true,
    "wrap": true,
    "collapse": true
  }
}
