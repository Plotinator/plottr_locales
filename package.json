{
  "name": "plottr_web",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "seed-firestore": "yarn --cwd lib/plottr_firebase seed-firestore",
    "grant-all-permissions": "yarn --cwd lib/plottr_firebase grant-all-permissions",
    "grant-collab-permissions": "yarn --cwd lib/plottr_firebase grant-collab-permissions",
    "grant-test-permissions": "yarn --cwd lib/plottr_firebase grant-test-permissions",
    "start-emulators": "yarn --cwd lib/plottr_firebase firebase emulators:start",
    "preinstall": "yarn --cwd lib/plottr_firebase install",
    "postinstall": "npm --prefix lib/plottr_components install",
    "dev": "npm-run-all --parallel dev:*",
    "dev:nextjs": "next dev",
    "dev:plottr_components": "npm --prefix lib/plottr_components run start",
    "build": "npm-run-all build:*",
    "build:plottr_components": "npm --prefix lib/plottr_components run compile",
    "build:next": "next build",
    "test": "jest '(lib.*)|(pages.*)'",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "validate": "npm-run-all format:check lint"
  },
  "dependencies": {
    "adm-zip": "^0.5.6",
    "classnames": "^2.3.1",
    "core-js": "^3.12.1",
    "docx": "^5.0.2",
    "js-cookie": "^2.2.1",
    "js-file-download": "^0.4.12",
    "jsrtf": "^0.0.3",
    "luxon": "^2.0.2",
    "mixpanel-browser": "^2.41.0",
    "next": "10.2.0",
    "plottr_components": "link:./lib/plottr_components",
    "plottr_firebase": "link:./lib/plottr_firebase",
    "plottr_locales": "link:./lib/plottr_locales",
    "pltr": "link:./lib/pltr",
    "react": "16.14.0",
    "react-bootstrap": "^0.32.4",
    "react-dom": "16.14.0",
    "react-icons": "^3.11.0",
    "react-proptypes": "^1.0.0",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "redux-thunk": "^2.3.0",
    "redux-undo": "^1.0.1",
    "regenerator-runtime": "^0.13.7",
    "semver": "^7.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.14.3",
    "@babel/node": "^7.14.2",
    "@babel/preset-env": "^7.14.2",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^27.1.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.6",
    "eslint": "^7.26.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.23.2",
    "jest": "^27.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.0",
    "sass": "^1.32.13",
    "sass-loader": "^7.3.1"
  }
}
