{
  "name": "plottr_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:nextjs": "next dev",
    "dev:plottr_components": "npm --prefix lib/plottr_components run start",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "validate": "npm-run-all format:check lint"
  },
  "dependencies": {
    "next": "10.2.0",
    "next-redux-wrapper": "^6.0.2",
    "plottr_components": "file:./lib/plottr_components",
    "plottr_locales": "file:./lib/plottr_locales",
    "pltr": "file:./lib/pltr",
    "react": "^16.8.6",
    "react-dom": "^16.8.6",
    "react-redux": "^7.2.4",
    "redux": "^4.1.0",
    "redux-undo": "^1.0.1",
    "semver": "^7.1.3"
  },
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "eslint": "^7.26.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.23.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.0"
  }
}
