{
  "name": "plottr",
  "version": "2024.5.25-alpha.2",
  "description": "A visual story-planning tool",
  "repository": "https://github.com/cameronsutter/plottr_electron.git",
  "homepage": "plottr.com",
  "private": true,
  "readme": "Copyright 2016-2020 Fictional Devices LLC",
  "author": {
    "name": "Cameron Sutter",
    "email": "cameronsutter0@gmail.com",
    "url": "https://twitter.com/camsutter"
  },
  "main": "bin/electron_main.js",
  "scripts": {
    "analyse-bundle": "webpack --profile --json > bin/stats.json",
    "analyse-bundle:view": "webpack-bundle-analyzer bin/stats.json",
    "spit-out-version": "node build/spit-out-version.js",
    "start": "cross-env NODE_ENV=dev electron --inspect=5858 --enable-test-utilities .",
    "compile": "cross-env NODE_ENV=production node_modules/.bin/webpack",
    "watch": "cross-env NODE_ENV=dev node_modules/.bin/webpack",
    "pack": "cross-env NODE_ENV=production node_modules/.bin/webpack",
    "pack:windows": "cross-env NODE_ENV=production node_modules\\.bin\\webpack",
    "clean:sharp-modules": "rimraf node_modules/sharp/node_modules",
    "clean:sharp-vendor": "rimraf node_modules/sharp/vendor",
    "clean:sharp": "npm run clean:sharp-vendor && npm run clean:sharp-modules",
    "install-sharp:macos-x64": "cd node_modules/sharp && cross-env npm_config_arch=x64 npm_config_platform=darwin npm install && cd ../.. && npm run clean:sharp-modules",
    "install-sharp:macos-arm64": "cd node_modules/sharp && cross-env npm_config_arch=arm64 npm_config_platform=darwin npm install && cd ../.. && npm run clean:sharp-modules",
    "install-sharp:linux": "cd node_modules/sharp && cross-env npm_config_arch=x64 npm_config_platform=linux npm install && cd ../.. && npm run clean:sharp-modules",
    "dist:common": "npm run spit-out-version && node build/initEnv.js && npm run pack",
    "dist:macos-x64": "npm run install-sharp:macos-x64 && cross-env DEBUG=electron-notarize* electron-builder -m --x64 --publish always",
    "dist:macos-arm64": "npm run install-sharp:macos-arm64 && cross-env DEBUG=electron-notarize* electron-builder -m --arm64 --publish always",
    "dist:linux": "npm run install-sharp:linux && electron-builder -l --x64 --publish always",
    "dist:macos-and-linux": "npm run dist:common && npm run dist:macos-x64 && npm run clean:sharp && npm run dist:macos-arm64 && npm run clean:sharp && npm run dist:linux",
    "dist:windows": "npm run spit-out-version && node build/initEnv.js && npm run pack:windows && electron-builder -w --publish always",
    "extract-strings": "lib/plottr_locales/lib/format-message-cli/format-message extract -o lib/plottr_locales/src/en-extracted.json \"bin/**/*.js\" \"src/**/*.js\" \"shared/**/*.js\" \"lib/plottr_components/src/**/*.js\" \"lib/pltr/v2/**/*.js\" && npm --prefix lib/plottr_locales run sync && npm run generate-flipped",
    "generate-flipped": "node ./lib/plottr_locales/src/build-flipped-locale.js",
    "test": "jest --runInBand \"(src.*)|(lib.*)|(main.*)\" && npm run integration-test",
    "integration-test": "babel-node --config-file ./babel-test.config.js main/server/__tests__/StatusManager.integration.js && babel-node --config-file ./babel-test.config.js src/app/__tests__/saver.integration.js && cross-env NODE_ENV=production node_modules/.bin/webpack --config=socket-server-only.config.js && cross-env NODE_ENV=test babel-node --config-file ./babel-test.config.js main/server/__tests__/server.integration.js",
    "test:watch": "jest \"(src.*)|(lib.*)|(main.*)\" --watch",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand lib/plottr_components/src/components/rce/__tests__/Normalizer.test.js",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "validate": "npm-run-all format:check lint test",
    "import-test": "npm run test:aCoronersTale && npm run test:fractureTest && npm run test:theTurn && npm run test:import-scrivener",
    "clean": "rimraf node_modules/"
  },
  "dependencies": {
    "cryptr": "^6.3.0",
    "utf-8-validate": "^5.0.9",
    "ws": "^8.5.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.1",
    "@babel/core": "^7.12.9",
    "@babel/node": "^7.20.2",
    "@babel/plugin-proposal-class-properties": "^7.4.4",
    "@babel/plugin-transform-modules-commonjs": "^7.12.1",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@babel/runtime": "^7.21.0",
    "@electron/notarize": "^2.1.0",
    "@react-icons/all-files": "https://github.com/react-icons/react-icons/releases/download/v5.2.0/react-icons-all-files-5.2.0.tgz",
    "@welldone-software/why-did-you-render": "^6.2.3",
    "animated-scroll-to": "^2.3.0",
    "assert": "^2.0.0",
    "autoprefixer": "^10.4.19",
    "axios": "^1.6.8",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^26.6.3",
    "babel-loader": "^8.2.3",
    "babel-plugin-lodash": "^3.3.4",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "buffer": "^6.0.3",
    "bufferutil": "^4.0.7",
    "changelog": "^1.4.2",
    "circular-dependency-plugin": "^5.2.2",
    "classnames": "^2.2.6",
    "computer-name": "^0.1.0",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.0",
    "css-loader": "^3.0.0",
    "docx": "^7.8.2",
    "dom-helpers": "^3.4.0",
    "dom-parser": "^0.1.6",
    "dotenv": "^4.0.0",
    "dotenv-stringify": "^2.0.7",
    "dotenv-webpack": "^7.1.0",
    "duplicate-package-checker-webpack-plugin": "^3.0.0",
    "electron": "^22.3.24",
    "electron-builder": "^23.0.4",
    "electron-context-menu": "^2.5.2",
    "electron-log": "^4.4.8",
    "electron-updater": "^4.3.9",
    "electron-util": "^0.17.2",
    "electron-window-state": "^5.0.3",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.5",
    "eslint": "^7.18.0",
    "eslint-config-prettier": "^7.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.22.0",
    "fast-check": "^3.7.0",
    "file-loader": "^6.2.0",
    "firebase": "^10.2.0",
    "firebase-admin": "^11.10.1",
    "firebase-tools": "^12.4.8",
    "firebaseui": "^6.1.0",
    "flip": "^1.0.0",
    "format-message-cli": "^6.2.1",
    "hash-test-vectors": "^1.3.2",
    "htmlparser2": "^9.1.0",
    "image-conversion": "^2.1.1",
    "image-extensions": "^1.1.0",
    "immer": "^9.0.21",
    "invariant": "^2.2.4",
    "is-hotkey": "^0.1.8",
    "is-lite": "^0.8.2",
    "is-plain-object": "^5.0.0",
    "is-url": "^1.2.4",
    "jest": "^26.6.3",
    "jsdoc": "~4.0.2",
    "jsdom": "^16.7.0",
    "json-schema-traverse": "^1.0.0",
    "jsonfile": "^6.1.0",
    "jsrtf": "^0.0.3",
    "keycode": "^2.2.1",
    "lodash": "^4.17.21",
    "luxon": "^2.5.2",
    "mixpanel-browser": "^2.38.0",
    "mv": "^2.1.1",
    "net": "^1.0.2",
    "node-fetch-cjs": "^3.2.10",
    "node-machine-id": "^1.1.12",
    "npm-run-all": "^4.1.5",
    "pagedown": "^1.1.0",
    "path-exists": "^4.0.0",
    "prettier": "^2.2.1",
    "pretty-date": "^0.2.0",
    "prop-types-extra": "^1.1.1",
    "proper-lockfile": "^4.1.2",
    "ramda": "^0.29.0",
    "rc-tooltip": "^5.3.1",
    "react": "^16.14.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^16.14.0",
    "react-image-file-resizer": "^0.4.8",
    "react-is": "^16.13.1",
    "react-json-view": "^1.21.3",
    "react-modal": "^3.16.1",
    "react-overlays": "^5.2.1",
    "react-proptypes": "^1.0.0",
    "react-redux": "^7.2.9",
    "react-sticky-table": "^5.1.11",
    "react-test-renderer": "^16.8.6",
    "react-tiny-popover": "^7.2.4",
    "react-transition-group": "^4.4.5",
    "react-waypoint": "^10.3.0",
    "react.pure.component": "^1.2.0",
    "reactour": "^1.16.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "redux-undo": "^1.0.1",
    "reselect": "^4.1.8",
    "rimraf": "^3.0.2",
    "rollbar": "^2.26.2",
    "rtf.js": "^3.0.9",
    "sass": "^1.75.0",
    "sass-loader": "^10.2.1",
    "semver": "^7.6.0",
    "sharp": "^0.31.3",
    "slate": "^0.80.0",
    "slate-history": "^0.66.0",
    "slate-hyperscript": "^0.77.0",
    "slate-react": "^0.80.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "style-loader": "^0.13.0",
    "tiny-invariant": "^1.3.1",
    "tinycolor2": "^1.6.0",
    "tls": "^0.0.1",
    "uncontrollable": "^7.2.1",
    "url": "^0.11.0",
    "url-loader": "^4.1.1",
    "uuid": "^8.3.2",
    "warning": "^4.0.3",
    "web-vitals": "^1.1.2",
    "webpack": "^5.70.0",
    "webpack-bundle-analyzer": "^4.7.0",
    "webpack-cli": "^4.9.2",
    "xml-js": "^1.6.11",
    "yargs": "^17.7.1"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "build": {
    "electronVersion": "22.3.24",
    "appId": "com.plottr.app",
    "artifactName": "${productName}-${os}-${arch}-installer-latest.${ext}",
    "npmRebuild": false,
    "publish": [
      "github"
    ],
    "extraResources": [
      {
        "from": "node_modules/sharp",
        "to": "node_modules/sharp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "**/*",
      "!docs${/*}",
      "!shared${/*}",
      "!.browserslistrc",
      "!.env",
      "!.eslintrc.js",
      "!.firebaserc",
      "!.nvmrc",
      "!.prettierignore",
      "!.prettierrc",
      "!firebase.json",
      "!firestore.indexes.json",
      "!firestore.rules",
      "!storage.rules",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj,md,MD}",
      "!**/._*",
      "!.vscode${/*}",
      "!**/{.DS_Store,.git,CVS,RCS,SCCS,__pycache__,thumbs.db,.gitignore,.gitattributes,.editorconfig,.flowconfig,.yarn-metadata.json,.idea,appveyor.yml,.travis.yml,circle.yml,npm-debug.log,.nyc_output,yarn.lock,.yarn-integrity,.el,.http}",
      "!src${/*}",
      "!*.config.js",
      "!dev-app-update.yml",
      "!bin/*.map",
      "!examples${/*}",
      "!package.json",
      "!test${/*}",
      "!lib/${/*}",
      "!main${/*}"
    ],
    "copyright": "Copyright © 2022 Fictional Devices",
    "productName": "Plottr",
    "fileAssociations": [
      {
        "ext": "pltr",
        "name": "Plottr",
        "description": "An elegant writing tool to organize story plotlines",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "Plottr URL",
        "schemes": [
          "plottr"
        ],
        "role": "Editor"
      }
    ],
    "afterSign": "build/notarize.js",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "default",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "backgroundColor": "#ebf2f9",
      "title": "${productName} Installer",
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "publisherName": [
        "C Louis S, LLC",
        "Fictional Devices LLC"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${os}-installer-latest.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon1024x1024.png",
      "vendor": "Fictional Devices",
      "desktop": {
        "Name": "Plottr",
        "Type": "Application"
      }
    }
  }
}
