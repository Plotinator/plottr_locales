{
  "name": "plottr_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix lib/plottr_components install",
    "dev": "npm-run-all --parallel dev:*",
    "dev:nextjs": "next dev",
    "dev:plottr_components": "npm --prefix lib/plottr_components run start",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "validate": "npm-run-all format:check lint"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "core-js": "^3.12.1",
    "next": "10.2.0",
    "next-redux-wrapper": "^6.0.2",
    "plottr_components": "link:./lib/plottr_components",
    "plottr_locales": "link:./lib/plottr_locales",
    "pltr": "link:./lib/pltr",
    "react": "^16.8.6",
    "react-bootstrap": "^0.32.4",
    "react-dom": "^16.8.6",
    "react-icons": "^3.11.0",
    "react-proptypes": "^1.0.0",
    "react-redux": "^4.4.10",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "redux": "^3.5.2",
    "redux-undo": "^1.0.1",
    "regenerator-runtime": "^0.13.7",
    "semver": "^7.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.14.3",
    "@babel/node": "^7.14.2",
    "@babel/preset-env": "^7.14.2",
    "babel-eslint": "^10.1.0",
    "eslint": "^7.26.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.23.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.0",
    "sass": "^1.32.13"
  }
}
